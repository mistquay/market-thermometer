# syntax=docker/dockerfile:1.7
# 专用于 GitHub Actions 分阶段流水线（彻底零 QEMU）：
#   - prep 阶段仅在原生 $BUILDPLATFORM 上预备 /app/data（归属 nonroot 65532:65532）与目标架构二进制
#   - 最终阶段基于 gcr.io/distroless/static-debian12:nonroot，零 RUN 指令、自带 CA 证书、
#     二进制内嵌 time/tzdata 与 mt healthcheck，极速产出最小化 amd64 + arm64 镜像。

FROM --platform=$BUILDPLATFORM alpine:3.21 AS prep
ARG TARGETARCH
RUN mkdir -p /rootfs/app/data /rootfs/usr/local/bin \
    && chown -R 65532:65532 /rootfs/app
COPY --chmod=755 dist/linux/${TARGETARCH}/mt /rootfs/usr/local/bin/mt

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=prep /rootfs/ /

WORKDIR /app
USER nonroot:nonroot

ENV TZ=Asia/Shanghai \
    MT_DB=/app/data/mt.db \
    MT_LISTEN=0.0.0.0:8080

EXPOSE 8080
VOLUME ["/app/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["/usr/local/bin/mt", "healthcheck"]

ENTRYPOINT ["/usr/local/bin/mt"]
CMD ["serve"]
